    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Shimmer Capture (localhost)",
            "url": "http://localhost:5500/index.html",
            "webRoot": "${workspaceFolder}"
        },
        {
            // Same page against the scripted sensor, for working with no
            // hardware on the desk.
            "type": "chrome",
            "request": "launch",
            "name": "Shimmer Capture (localhost, ?mock=1)",
            "url": "http://localhost:5500/index.html?mock=1",
            "webRoot": "${workspaceFolder}"
        }
    ]
}
